{
  "name": "realtime-auction-master",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime live commerce auction MVP built with React, Express and Socket.IO.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm --workspace apps/server run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck"
  },
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
