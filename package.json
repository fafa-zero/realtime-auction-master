{
  "name": "realtime-auction-master",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime live commerce auction MVP built with React, Express and Socket.IO.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm --workspace apps/server run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:agent": "python3 -m uvicorn services.agent.app.main:app --host 0.0.0.0 --port 8100 --reload",
    "test:agent": "python3 -m pytest -q services/agent/tests",
    "test:agent-contract": "npm --workspace apps/server run test:agent-contract",
    "eval:agent": "python3 -m services.agent.evaluate",
    "test:websocket": "python3 -m pytest -q tests/websocket",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "load:auction": "locust -f tests/load/locustfile.py",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "demo": "npm --workspace apps/web run build && npm --workspace apps/server run build && npm --workspace apps/server run reset:demo && PORT=4300 CLIENT_URL=http://localhost:4300 npm --workspace apps/server run start",
    "demo:reset": "npm --workspace apps/server run build && npm --workspace apps/server run reset:demo",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck",
    "test:state-machine": "npm --workspace apps/server run test:state-machine"
  },
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
