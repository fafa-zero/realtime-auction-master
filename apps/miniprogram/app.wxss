page {
  min-height: 100vh;
  background: #f3f6f8;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  min-height: 88rpx;
  border-radius: 12rpx;
  font-weight: 700;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #ffffff;
}

.eyebrow {
  color: #d82f44;
  font-size: 24rpx;
  font-weight: 800;
}

.muted {
  color: #60717f;
}

.primary {
  color: #ffffff;
  background: #d82f44;
}

.secondary {
  color: #17212b;
  background: #ffffff;
  border: 1rpx solid #d9e1e7;
}

.price {
  color: #d82f44;
  font-weight: 900;
}
