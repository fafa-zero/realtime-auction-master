.header {
  display: grid;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
}

.login-card {
  display: grid;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #ffffff;
}

.login-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.login-card input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #fbfcfd;
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: #edf1f4;
}

.auth-tab {
  min-height: 68rpx;
  margin: 0;
  border: 0;
  border-radius: 10rpx;
  background: transparent;
  color: #60717f;
  font-size: 26rpx;
  line-height: 68rpx;
}

.auth-tab.active {
  background: #ffffff;
  color: #17212b;
}

.room-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #ffffff;
}

.room-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.room-meta,
.room-id {
  color: #60717f;
  font-size: 24rpx;
}

.room-id {
  font-weight: 800;
}

.error {
  color: #ad1f31;
}

.success {
  color: #12805c;
}
