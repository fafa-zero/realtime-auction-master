<view class="page">
  <view class="header">
    <text class="eyebrow">好物助手</text>
    <text class="title">选择好物专场</text>
    <text class="muted">{{userText}}</text>
    <text class="muted">{{apiText}}</text>
  </view>

  <view class="login-card">
    <view>
      <text class="login-title">{{authMode === "register" ? "买家注册" : "买家登录"}}</text>
      <text class="muted">
        {{authMode === "register" ? "先注册买家账号，注册成功后再登录进入专场。" : "使用已注册买家账号登录后进入好物专场。"}}
      </text>
    </view>
    <view class="auth-tabs">
      <button
        class="auth-tab {{authMode === 'login' ? 'active' : ''}}"
        data-mode="login"
        bindtap="setAuthMode"
      >
        登录
      </button>
      <button
        class="auth-tab {{authMode === 'register' ? 'active' : ''}}"
        data-mode="register"
        bindtap="setAuthMode"
      >
        注册
      </button>
    </view>
    <input
      value="{{nickname}}"
      placeholder="请输入买家昵称"
      bindinput="onNicknameInput"
      disabled="{{loggedIn}}"
    />
    <button
      wx:if="{{!loggedIn && authMode === 'login'}}"
      class="primary"
      loading="{{loggingIn}}"
      bindtap="loginBuyer"
    >
      登录进入专场
    </button>
    <button
      wx:elif="{{!loggedIn && authMode === 'register'}}"
      class="primary"
      loading="{{registering}}"
      bindtap="registerBuyer"
    >
      注册买家账号
    </button>
    <button wx:else class="secondary" bindtap="logout">取消登录</button>
  </view>

  <view wx:if="{{success}}" class="card success">{{success}}</view>
  <view wx:if="{{loading}}" class="card muted">正在加载专场...</view>
  <view wx:elif="{{error}}" class="card error">{{error}}</view>

  <view wx:elif="{{loggedIn}}">
    <view
      wx:for="{{rooms}}"
      wx:key="id"
      class="room-card"
      bindtap="openLive"
      data-id="{{item.id}}"
    >
      <view>
        <text class="room-title">{{item.title}}</text>
        <text class="room-meta">{{item.hostName}} / {{item.viewerCount}} 人观看</text>
      </view>
      <text class="room-id">{{item.id}}</text>
    </view>
  </view>
</view>
