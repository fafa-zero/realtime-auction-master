.stage {
  position: relative;
  overflow: hidden;
  height: 430rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: #111820;
}

.stage image {
  width: 100%;
  height: 100%;
}

.stage-overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: grid;
  gap: 8rpx;
  color: #ffffff;
}

.live-badge {
  width: 92rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #d82f44;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.stage-title {
  font-size: 36rpx;
  font-weight: 900;
}

.stage-meta {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.product {
  display: grid;
  gap: 10rpx;
}

.product-name {
  font-size: 38rpx;
  font-weight: 900;
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat {
  display: grid;
  gap: 8rpx;
  min-height: 128rpx;
  padding: 20rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #ffffff;
}

.stat text:first-child {
  color: #60717f;
  font-size: 24rpx;
}

.stat text:last-child {
  font-size: 34rpx;
  font-weight: 900;
}

.bid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 900;
}

.status {
  color: #12805c;
  font-size: 24rpx;
  font-weight: 800;
}

input {
  width: 100%;
  height: 88rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #fbfcfd;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #60717f;
  font-size: 24rpx;
}

.bid-row,
.order-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2f5;
}

.time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.error {
  color: #ad1f31;
}
