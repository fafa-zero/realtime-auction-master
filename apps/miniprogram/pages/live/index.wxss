.login-required {
  display: grid;
  gap: 18rpx;
}

.live-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.live-actions text {
  flex: 1;
  min-width: 0;
}

.compact-button {
  width: 180rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 24rpx;
  line-height: 68rpx;
}

.stage {
  position: relative;
  overflow: hidden;
  height: 430rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: #111820;
  border: 1rpx solid #263440;
  box-shadow: 0 18rpx 38rpx rgba(23, 33, 43, 0.2);
}

.stage image {
  width: 100%;
  height: 100%;
}

.stage-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: rgba(255, 255, 255, 0.7);
  font-size: 32rpx;
  font-weight: 900;
}

.danmaku-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 76rpx;
  bottom: 132rpx;
  overflow: hidden;
  pointer-events: none;
}

.danmaku-float {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 46rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.danmaku-float text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-0 {
  top: 0;
}

.row-1 {
  top: 54rpx;
}

.row-2 {
  top: 108rpx;
}

.row-3 {
  top: 162rpx;
}

.row-4 {
  top: 216rpx;
}

.stage-overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: grid;
  gap: 8rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: rgba(17, 24, 32, 0.58);
  color: #ffffff;
}

.live-badge {
  width: 92rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #d82f44;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.stage-title {
  font-size: 36rpx;
  font-weight: 900;
}

.stage-meta {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.realtime {
  max-width: 100%;
  overflow: hidden;
  width: fit-content;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.24);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.realtime-detail {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.product {
  display: grid;
  gap: 10rpx;
}

.ai-script {
  display: grid;
  gap: 10rpx;
  border-left: 6rpx solid #d82f44;
  line-height: 1.65;
}

.danmaku-card {
  display: grid;
  gap: 14rpx;
}

.danmaku-input-row {
  display: grid;
  grid-template-columns: 1fr 150rpx;
  gap: 12rpx;
  align-items: center;
}

.danmaku-input-row input {
  margin-bottom: 0;
}

.danmaku-button {
  min-height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  line-height: 88rpx;
}

.danmaku-row {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #eef2f5;
}

.danmaku-row view {
  min-width: 0;
}

.danmaku-row view text:first-child {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 800;
}

.danmaku-content {
  color: #17212b;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.product-name {
  font-size: 38rpx;
  font-weight: 900;
}

.stock {
  color: #12805c;
  font-size: 26rpx;
  font-weight: 900;
}

.product-state {
  padding: 14rpx 16rpx;
  border-left: 6rpx solid #d82f44;
  border-radius: 8rpx;
  background: #fff6f7;
  color: #334250;
  font-size: 24rpx;
  line-height: 1.55;
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat {
  display: grid;
  gap: 8rpx;
  min-height: 128rpx;
  padding: 20rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(23, 33, 43, 0.04);
}

.stat:nth-child(1) text:last-child,
.stat:nth-child(4) text:last-child {
  color: #d82f44;
}

.stat:nth-child(2) text:last-child,
.stat:nth-child(5) text:last-child {
  color: #12805c;
}

.stat text:first-child {
  color: #60717f;
  font-size: 24rpx;
}

.stat text:last-child {
  font-size: 34rpx;
  font-weight: 900;
}

.bid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 900;
}

.status {
  color: #12805c;
  font-size: 24rpx;
  font-weight: 800;
}

.auction-progress {
  display: grid;
  gap: 14rpx;
}

.progress-track {
  overflow: hidden;
  height: 18rpx;
  border-radius: 999rpx;
  background: #edf1f4;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #d82f44;
}

input {
  width: 100%;
  height: 88rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #fbfcfd;
}

.bid-quick-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.bid-quick-button {
  min-height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  font-size: 24rpx;
  line-height: 72rpx;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #60717f;
  font-size: 24rpx;
}

.bid-row,
.order-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2f5;
}

.time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.error {
  color: #ad1f31;
}
