.header {
  display: grid;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
}

.order-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #ffffff;
}

.buyer {
  display: block;
  margin-bottom: 10rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.order-side {
  display: grid;
  gap: 8rpx;
  text-align: right;
}

.status {
  color: #12805c;
  font-size: 24rpx;
  font-weight: 800;
}

.error {
  color: #ad1f31;
}
