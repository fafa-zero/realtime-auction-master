.header {
  display: grid;
  gap: 10rpx;
  margin-bottom: 28rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #17212b;
  box-shadow: 0 16rpx 34rpx rgba(23, 33, 43, 0.16);
}

.header .eyebrow,
.header .muted {
  color: rgba(255, 255, 255, 0.68);
}

.header .title {
  color: #ffffff;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
}

.order-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid #d9e1e7;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(23, 33, 43, 0.05);
}

.buyer {
  display: block;
  margin-bottom: 10rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.order-side {
  display: grid;
  gap: 8rpx;
  text-align: right;
}

.status {
  color: #12805c;
  font-size: 24rpx;
  font-weight: 800;
}

.error {
  color: #ad1f31;
}
